# Copiez ce fichier en « .env » et remplissez les trois premières valeurs.
# Le fichier .env n'est jamais versionné (voir .gitignore).

# --- Obligatoire ----------------------------------------------------------

# Clé d'installation. Elle n'ouvre pas l'application : elle autorise la
# création du tout premier compte, pour qu'un inconnu tombant sur l'adresse
# avant vous ne puisse pas s'en emparer. Vous la saisirez une fois, sur l'écran
# de création de compte. Choisissez-en une longue, propre à cet outil.
MOT_DE_PASSE=

# Clé de signature des sessions. Générez-la avec :
#   openssl rand -hex 32
SECRET_SESSION=

# --- Nom de domaine -------------------------------------------------------

# Renseignez votre domaine pour que Caddy active l'HTTPS automatiquement.
# Laissez la ligne commentée si vous n'avez pas encore de domaine : le site
# répondra alors en HTTP sur l'IP du serveur, et l'application s'y adapte
# (le cookie de session n'est marqué « secure » que lorsqu'un domaine est
# configuré, sinon la connexion serait impossible).
#DOMAINE=projets.mondomaine.fr

# --- Mentions légales ------------------------------------------------------
# Identité de l'éditeur affichée sur la page /mentions-legales. Laissez ces
# lignes commentées et la page reste valide, avec une formulation générique.

#EDITEUR=Unité de recherche clinique — Centre hospitalier universitaire de …
#EDITEUR_CONTACT=recherche-clinique@mondomaine.fr

# --- Développement local uniquement ---------------------------------------
# Ces valeurs sont déjà définies dans le conteneur Docker : ne les renseignez
# que si vous lancez l'application directement avec « npm run dev ».

#CHEMIN_BASE=./data/gestionprojet.db
#DOSSIER_UPLOADS=./data/uploads
