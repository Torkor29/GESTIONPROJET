# Copiez ce fichier en « .env » et remplissez les deux premières lignes.
# Le fichier .env n'est jamais versionné (voir .gitignore).

# Mot de passe d'accès à l'application. Choisissez-en un long.
MOT_DE_PASSE=

# Clé de signature des sessions. Générez-la avec :
#   openssl rand -hex 32
SECRET_SESSION=

# Emplacement de la base et des fichiers téléversés.
# Valeurs par défaut adaptées au conteneur Docker ; en local, laissez vide.
CHEMIN_BASE=./data/gestionprojet.db
DOSSIER_UPLOADS=./data/uploads

# Port d'écoute de l'application.
PORT=3000
