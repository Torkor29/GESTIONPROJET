# Caddy obtient et renouvelle le certificat HTTPS tout seul, gratuitement,
# dès qu'un vrai nom de domaine est renseigné dans DOMAINE.
{$DOMAINE} {
	encode zstd gzip

	# Corps de requête plafonné : correspond à la limite de téléversement
	# appliquée côté application (25 Mo) avec une marge pour l'enveloppe.
	request_body {
		max_size 30MB
	}

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}

	reverse_proxy app:3000 {
		# Le schéma réel (http/https) doit arriver jusqu'à l'application :
		# c'est lui qui décide si le cookie de session est marqué « secure ».
		header_up X-Forwarded-Proto {scheme}
		header_up X-Forwarded-Host {host}
		header_up Host {host}
	}
}

# « www » renvoie vers le domaine nu, pour que les deux écritures fonctionnent
# sans dupliquer l'adresse du site. Sans nom de domaine configuré, DOMAINE_WWW
# vaut une adresse locale inerte : ce bloc n'est alors joignable par personne.
{$DOMAINE_WWW} {
	redir https://{$DOMAINE}{uri} permanent
}
